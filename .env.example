# Copy to .env.local and fill in. Never commit real values.

# Demo Supabase project (Project Settings -> API Keys). Server-only.
SUPABASE_URL=
# The secret key (starts with sb_secret_). Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# The project ref, the part of SUPABASE_URL before .supabase.co.
# seed, reset and db:push refuse to run when it does not match SUPABASE_URL.
DEMO_SUPABASE_PROJECT_ID=

# Postgres connection string for applying migrations (npm run db:push).
# Supabase dashboard -> Connect -> Session pooler. Local use only, not needed on Vercel.
SUPABASE_DB_URL=

# The publishable key (starts with sb_publishable_). Only used by npm run check:rls
# to prove the public key can read nothing. The app itself never uses it.
SUPABASE_PUBLISHABLE_KEY=

# Public origin used for QR links and redirects, e.g. https://fairafric-demo.thefindeapp.com
PUBLIC_BASE_URL=http://localhost:3000

# Dashboard gate (slice 4).
DEMO_DASHBOARD_PASSWORD=
DEMO_SESSION_SECRET=
